<?xml version="1.0" encoding="utf-8"?>
<!-- kolom catatan perasaan bersudut membulat (shape rectangle, Modul P9 hlm 10) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Warna solid untuk latar belakang -->
    <solid android:color="@color/white" />
    <!-- Garis tepi (stroke) warna ungu senja Rehat -->
    <stroke
        android:width="1dp"
        android:color="@color/twilight_purple" />
    <!-- Sudut yang membulat -->
    <corners android:radius="12dp" />
    <!-- Padding di dalam EditText -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
