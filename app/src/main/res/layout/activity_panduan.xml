<?xml version="1.0" encoding="utf-8"?>
<!-- Panduan Rehat: ViewPager2 + SpringDotsIndicator (Modul P9 hlm 16-19 | prak: activity_tutorial_message.xml) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/midnight_blue"
    tools:context=".halaman.panduan.PanduanActivity">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpPanduan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- titik penanda halaman, di atas tombol Lewati/Mulai.
         Modul memakai DotsIndicator; praktikum (dan Rehat) memakai SpringDotsIndicator -->
    <com.tbuonomo.viewpagerdotsindicator.SpringDotsIndicator
        android:id="@+id/dotPanduan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="92dp"
        app:dotsColor="@color/titik_panduan_aktif"
        app:dotsCornerRadius="10dp"
        app:dotsSpacing="5dp"
        app:progressMode="true"
        app:selectedDotColor="@color/titik_panduan"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
