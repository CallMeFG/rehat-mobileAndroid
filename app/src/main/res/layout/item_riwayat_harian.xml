<?xml version="1.0" encoding="utf-8"?>
<!-- satu baris RecyclerView riwayat harian, dibungkus MaterialCardView (Modul P10 hlm 12-13 | prak: item_product.xml) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/lavender_mist"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/twilight_purple"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvHariTanggal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/outfit_bold"
                android:textColor="@color/midnight_blue"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@+id/tvEnergiHarian"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Kamis, 12 Nov" />

            <TextView
                android:id="@+id/tvStatusHarian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_semibold"
                android:textColor="@color/twilight_purple"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="@+id/tvHariTanggal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvHariTanggal"
                tools:text="Energi Rendah" />

            <TextView
                android:id="@+id/tvEnergiHarian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:textColor="@color/dusk_indigo"
                android:textSize="28sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="35%" />

            <TextView
                android:id="@+id/tvDetailHarian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/midnight_blue"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvStatusHarian"
                tools:text="Tidur 4j 30m · 4 tugas atau lebih · Penyebab lelah: Begadang" />

            <TextView
                android:id="@+id/tvCatatanHarian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/dusk_indigo"
                android:textSize="13sp"
                android:textStyle="italic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvDetailHarian"
                tools:text="Catatan: Begadang menyelesaikan laporan praktikum." />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
