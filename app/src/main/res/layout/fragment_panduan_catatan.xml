<?xml version="1.0" encoding="utf-8"?>
<!-- Panduan langkah 1 dari 4: cara memakai fitur (Tutorial Screen, Modul P9 hlm 14-15) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panduan_langit_1"
    tools:context=".halaman.panduan.PanduanCatatanFragment">

    <TextView
        android:id="@+id/tvLangkahKe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:fontFamily="@font/outfit_semibold"
        android:text="@string/panduan_catatan_langkah_ke"
        android:textColor="@color/starlight_yellow"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgPanduan"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/panduan_catatan_judul"
        app:srcCompat="@drawable/ic_tulis_catatan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLangkahKe" />

    <TextView
        android:id="@+id/tvJudulPanduan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="@font/outfit_bold"
        android:gravity="center"
        android:text="@string/panduan_catatan_judul"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgPanduan" />

    <!-- langkah pemakaian bernomor di dalam MaterialCardView -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLangkahPanduan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        app:cardBackgroundColor="@color/lavender_mist"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/starlight_yellow"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvJudulPanduan">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvLangkahPanduan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="@string/panduan_catatan_langkah"
                android:textColor="@color/midnight_blue"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvHasilPanduan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/outfit_semibold"
                android:text="@string/panduan_catatan_hasil"
                android:textColor="@color/twilight_purple"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- tombol Lewati (Modul P9 latihan 7.4) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLewatiPanduan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/twilight_purple"
        android:fontFamily="@font/outfit_semibold"
        android:text="@string/panduan_btn_lewati"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
